{
  "u0050": "AHCI: 포트 %d의 BLK %d에서 sys_compile_time 발견\\n",
  "u0051": "RSP       RSP+Offset: 값               값/링크\\n",
  "u0052": "$$LM,4$$$$RED$$CD/DVD 드라이브 $$LTBLUE$$ATAPI$$FG$$\\n",
  "u0053": "$$GREEN$$A$$FG$$-$$GREEN$$B$$FG$$는 RAM 드라이브입니다.\\n",
  "u0054": "작성 중인 메시에는 다음 원점을 사용하세요\\n",
  "u0055": "$$LTCYAN$$ %%시간 횟수:    &Function+Offset$$FG$$\\n",
  "u0056": "$$LTCYAN$$ #    W  x   H     종횡비$$FG$$\\n\\n",
  "u0057": "$$MU-UL,\\\"변환 끄기 (3D 아이콘용)\\\",",
  "u0058": "$$LM,4$$$$RED$$하드 드라이브   $$LTBLUE$$ATA$$FG$$\\n",
  "u0059": "비트맵 범위만큼 사각형을\\n드래그하세요.\\n",
  "u0060": "출시일\\t\\t:$$BLACK$$%s (mm/dd/yyyy)$$FG$$\\n",
  "u0061": " \\0기타\\0알 수 없음\\0사용 가능\\0사용 중\\0사용 불가",
  "u0062": "$$BLACK$$%4d x %4d$$FG$$   %0.3f =%4d:%d $$LM,0$$",
  "u0063": "DolDoc/명령줄 (일반적);명령줄 (일반적)",
  "u0064": "$$MU-UL,\\\"+] 이동 가능한 3D 메시 생성/편집\\\",",
  "u0065": "$$MU-UL,\\\"+] 비트맵으로 변환 또는 비트맵 편집\\\",",
  "u0066": "$$GREEN$$변환 끄기$$FG$$가 사용되었습니다.\\n\\n",
  "u0067": "파일/명령줄 (일반적);명령줄 (일반적)",
  "u0068": "그래픽/입력;그래픽/수학/3D 변환",
  "u0069": "사각형 하나를 그린 후 '$$GREEN$$r$$FG$$' 키를 누르세요\\n",
  "u0070": "그려질 때입니다.  아마\\n",
  "u0071": "$$BLACK$$하위 메모리\\t:00100000$$FG$$\\n$$ID,2$$",
  "u0072": "%4d x %4d   %0.3f =%4d:%d (현재 해상도)",
  "u0073": "선택한 후 'Insert shift sub-origin'을 실행하세요\\n",
  "u0074": "($$PURPLE$$<ENTER>$$FG$$를 누르면 기본값 사용):",
  "u0075": "$$LTCYAN$$RBP:       *RBP:     *RBP:$$FG$$\\n",
  "u0076": "$$PURPLE$$$$TX+CX,\\\"스프라이트 비트맵 메뉴\\\"$$\\n",
  "u0077": "옵션 (완료 시 $$PURPLE$$<ENTER>$$FG$$):",
  "u0078": "$$PURPLE$$$$TX+CX,\\\"페이지 설정 메뉴\\\"$$\\n",
  "u0079": "$$PURPLE$$$$TX+CX,\\\"텍스트 위젯 메뉴\\\"$$\\n",
  "u0080": "$$BLACK$$코드/데이터 힙\\t:%08X/%08X$$FG$$\\n",
  "u0081": "$$ID,3$$소켓 이름\\t\\t:$$BLACK$$%s$$FG$$\\n",
  "u0082": "$$CB,\\\"무제한 길이로 재할당\\\"$$\\n",
  "u0083": "$$PURPLE$$$$TX+CX,\\\"스프라이트 편집 메뉴\\\"$$\\n",
  "u0084": "$$PURPLE$$$$TX+CX,\\\"스프라이트 기본 메뉴\\\"$$\\n",
  "u0085": "$$LTCYAN$$  크기  * 개수  = 합계$$FG$$\\n",
  "u0086": "지원되는 SRAM 유형\\t:$$BLACK$$%s$$FG$$\\n",
  "u0087": "$$RED$$제조사$$FG$$: $$LTBLUE$$%s$$FG$$\\n",
  "u0088": "$$RED$$장치$$FG$$: $$LTBLUE$$%s$$FG$$\\n",
  "u0089": "버스: 0x%02X, 장치: 0x%02X, 기능: 0x%02X\\n\\n",
  "u0090": "bd->file_disk_name = SysStrNew(\\\"%s\\\");\\n",
  "u0091": "$$PURPLE$$$$TX+CX,\\\"색상 유형 메뉴\\\"$$\\n",
  "u0092": "설치된 SRAM 유형\\t:$$BLACK$$%Z$$FG$$\\n",
  "u0093": "$$PURPLE$$$$TX+CX,\\\"링크 유형 메뉴\\\"$$\\n",
  "u0094": "스프라이트 크기를 소스 코드에 삽입합니다.\\n",
  "u0095": "아마 주변을 이동하게 될 것입니다\\n",
  "u0096": "영역을 채우기 위해 선을 사용하고 있기 때문입니다\\n",
  "u0097": "$$GREEN$$'t'$$FG$$: 삼각형 구성 모드\\n",
  "u0098": "$$BLACK$$코드 힙\\t:%010X/%010X$$FG$$\\n",
  "u0099": "$$BLACK$$데이터 힙\\t:%010X/%010X$$FG$$\\n"
}
